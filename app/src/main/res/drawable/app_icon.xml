<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:startColor="#6A9BFF"
                android:endColor="#3355D1"
                android:angle="135" />
        </shape>
    </item>
    <item
        android:left="11dp"
        android:top="11dp"
        android:right="11dp"
        android:bottom="11dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#DDFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
