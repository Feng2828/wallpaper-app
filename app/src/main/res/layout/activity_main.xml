<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#1F2937"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="只有你点【手动同步】时才读取相册，没有后台扫描"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <!-- ① 相册文件夹 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="① 相册文件夹"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="未选择"
                android:textColor="#3B6FE0"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_pick"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_primary"
                android:text="选择相册文件夹"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="选中整个文件夹即一次导入全部图片；建议在「文件管理」里使用真实存在的文件夹（如 Pictures/风景）。选中时会自动导入一次，之后只有点【手动同步】才会再读相册。"
                android:textColor="#8A93A6"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ② 手动同步 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="② 手动同步"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_pool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="壁纸池：0 张"
                android:textColor="#374151"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_sync"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_primary"
                android:text="手动同步"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="新增的图片会加入、已删除的图片会移除；不点同步就不会扫描。"
                android:textColor="#8A93A6"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ③ 切换间隔 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="③ 切换间隔（随机抽取）"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_60"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="60 秒"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_120"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="120 秒"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- 启用与保活（必要入口，非附加功能） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btn_set_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_primary"
                android:text="设为动态壁纸"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_keep_alive"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary"
                android:text="后台保活 / 权限设置"
                android:textColor="#2F4E9B"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="双击壁纸空白处立即换一张；息屏后重新亮屏解锁自动换一张新图。\n若双击无效，多为系统桌面拦截触摸，可在桌面设置里关闭双击手势后重试。"
                android:textColor="#8A93A6"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:text="首次使用顺序：选文件夹 → 手动同步 → 选间隔 → 设为动态壁纸 → 后台保活设置"
            android:textColor="#9AA3B5"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
